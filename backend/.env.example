# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/innsync

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# External APIs
# HOTEL_BOOKING_API_KEY=
# HOTEL_BOOKING_API_URL=
# FOLIO_PROVIDER_API_KEY=
# HOUSEKEEPING_PROVIDER_API_KEY=
# ACTIVITY_PROVIDER_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:3001
